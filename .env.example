# ——— MySQL ———
# For local development use localhost / XAMPP / WAMP
# For Vercel / production, use a public MySQL (PlanetScale, Aiven, Railway, AWS RDS, etc.)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_crm

# ——— Backend API ———
API_PORT=4000
# Comma-separated allowed origins (for Vercel add your *.vercel.app domain)
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ——— Frontend ———
# Override API base URL if backend is hosted separately (e.g. Railway / Render / VPS)
# VITE_API_BASE=https://your-api-domain.example.com/api

# ——— Python AI module (optional) ———
# PYTHON_BIN=python
